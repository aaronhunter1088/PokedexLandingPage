{
  "name": "pokedex-landing-page",
  "version": "1.10.1",
  "scripts": {
    "ng": "ng",
    "startLandingPage": "ng serve",
    "startLandingPageAndMobile": "ng serve --host 0.0.0.0",
    "installLandingPage": "npm install",
    "deployLandingPageForServer": "ng build --base-href / --deploy-url /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "vulnerability": "npm audit",
    "vulnerabilityFixDryRun": "npm audit fix --dry-run"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "ngx-color": "^10.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/jasmine": "~7.0.0",
    "jasmine-core": "~7.0.2",
    "jsdom": "^30.1.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
